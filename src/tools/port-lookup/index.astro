      ><tr
        ><td class="mono">68</td><td><strong>DHCP Client</strong></td><td>UDP</td><td
          >Dynamic Host Config (client)</td
        ></tr
      ><tr
        ><td class="mono">69</td><td><strong>TFTP</strong></td><td>UDP</td><td
