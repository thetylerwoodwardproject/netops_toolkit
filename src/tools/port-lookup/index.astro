      ><tr
        ><td class="mono">80</td><td><strong>HTTP</strong></td><td>TCP</td><td
          >Web traffic (unencrypted)</td
        ></tr
      ><tr
        ><td class="mono">88</td><td><strong>Kerberos</strong></td><td>TCP/UDP</td><td
