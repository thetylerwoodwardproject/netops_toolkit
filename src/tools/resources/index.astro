---
import Icon from '@/components/Icon.astro';
---

<div class="panel">
  <h3>
    <Icon name="file-lines" class="mr-1 inline align-[-2px] text-accent" /> Cisco & Networking Cheat Sheets
  </h3><div class="flex flex-col gap-[2px]">
    <a
      href="https://netwrix.com/en/resources/guides/cisco-commands-cheat-sheet-for-device-configuration/"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> Netwrix — Cisco Commands Cheat Sheet</a
    ><a
      href="https://github.com/grplyler/cisco-cheatsheet"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> grplyler/cisco-cheatsheet — GitHub CLI Reference</a
    ><a
      href="https://www.comparitech.com/net-admin/cisco-cli-switch-command-cheat-sheet/"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> Comparitech — Cisco CLI Switch Commands</a
    ><a
      href="https://ipcisco.com/cheat-sheets/"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> IPCisco — Networking Protocol Cheat Sheets</a
    >
  </div>
</div><div class="panel">
  <h3>
    <Icon name="graduation-cap" class="mr-1 inline align-[-2px] text-accent" /> Training & Certification
  </h3><div class="flex flex-col gap-[2px]">
    <a
      href="https://www.comptia.org/en-us/certifications/network/"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> CompTIA Network+ (N10-009) — Official Page</a
    ><a
      href="https://www.professormesser.com/get-n10-009-network-plus-certified/"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> Professor Messer — Free Network+ N10-009 Videos</a
    ><a
      href="https://www.cbtnuggets.com/common-ports"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> CBT Nuggets — Common Ports Reference</a
    >
  </div>
</div><div class="panel">
  <h3><Icon name="wrench" class="mr-1 inline align-[-2px] text-accent" /> Online Tools</h3><div
    class="flex flex-col gap-[2px]"
  >
    <a
      href="https://it-tools.tech"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> IT-Tools.tech — Developer & IT Tool Collection</a
    ><a
      href="https://subnetcalculator.dev"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> Subnet Calculator — Online CIDR/VLSM Tool</a
    ><a
      href="https://jodies.de"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> jodies.de — IP Subnet Calculator</a
    ><a
      href="https://dnschecker.org/mac-lookup.php"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> MAC Address Vendor Lookup</a
    ><a
      href="https://www.wireshark.org/download.html"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> Wireshark — Packet Analyzer Download</a
    >
  </div>
</div><div class="panel">
  <h3>
    <Icon name="tower-broadcast" class="mr-1 inline align-[-2px] text-accent" /> Vendor Documentation
  </h3><div class="flex flex-col gap-[2px]">
    <a
      href="https://www.cisco.com/c/en/us/td/docs/ios-xml/ios/fundamentals/command/cf_command_ref.html"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> Cisco IOS Command Reference</a
    ><a
      href="https://www.juniper.net/documentation/"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> Juniper Networks Documentation</a
    ><a
      href="https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/9/html/configuring_and_managing_networking/"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-[8px] rounded-field px-[8px] py-[6px] text-[12.5px] transition-colors hover:bg-surface2"
      ><span class="text-text3">→</span> RHEL 9 Networking Guide</a
    >
  </div>
</div>
