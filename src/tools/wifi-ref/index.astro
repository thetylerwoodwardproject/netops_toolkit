---
import Icon from '@/components/Icon.astro';

const rows = [
  ['—', '802.11b', '1999', '2.4 GHz', '11 Mbps', '22 MHz', 'DSSS', 'First widely adopted'],
  [
    '—',
    '802.11a',
    '1999',
    '5 GHz',
    '54 Mbps',
    '20 MHz',
    'OFDM',
    'Less interference, shorter range',
  ],
  ['—', '802.11g', '2003', '2.4 GHz', '54 Mbps', '20 MHz', 'OFDM', 'Backward compat. with b'],
  [
    'Wi-Fi 4',
    '802.11n',
    '2009',
    '2.4/5 GHz',
    '600 Mbps',
    '20/40 MHz',
    'OFDM',
    'MIMO (up to 4 streams)',
  ],
  [
    'Wi-Fi 5',
    '802.11ac',
    '2013',
    '5 GHz',
    '3.5 Gbps',
    '20–160 MHz',
    'OFDM',
    'MU-MIMO, 256-QAM, beamforming',
  ],
  [
    'Wi-Fi 6',
    '802.11ax',
    '2020',
    '2.4/5 GHz',
    '9.6 Gbps',
    '20–160 MHz',
    'OFDMA',
    'BSS Coloring, TWT, WPA3',
  ],
  [
    'Wi-Fi 6E',
    '802.11ax',
    '2021',
    '2.4/5/6 GHz',
    '9.6 Gbps',
    '20–160 MHz',
    'OFDMA',
    '6 GHz band (1200 MHz new spectrum)',
  ],
  [
    'Wi-Fi 7',
    '802.11be',
    '2024',
    '2.4/5/6 GHz',
    '~46 Gbps',
    'Up to 320 MHz',
    'OFDMA',
    'MLO, 4096-QAM, 16 streams',
  ],
];
---

<div class="table-wrap">
  <table class="ref-table">
    <thead>
      <tr>
        <th>Gen</th><th>Standard</th><th>Year</th><th>Frequency</th><th>Max Speed</th><th
          >Channel</th
        ><th>Modulation</th><th>Key Feature</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(([gen, std, year, freq, speed, channel, mod, feature]) => (
          <tr>
            <td>
              <strong>{gen}</strong>
            </td>
            <td class="mono">{std}</td>
            <td>{year}</td>
            <td>{freq}</td>
            <td>
              <strong>{speed}</strong>
            </td>
            <td>{channel}</td>
            <td>{mod}</td>
            <td>{feature}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<div class="tip mt-3">
  <Icon name="wifi" />
  <strong>2.4 GHz:</strong> 3 non-overlapping channels (1, 6, 11), better range, more interference.
  <strong>5 GHz:</strong> 25 non-overlapping channels, faster, shorter range. <strong>6 GHz:</strong
  >
  Wi-Fi 6E/7 only, 59 channels, least congestion.
</div>
