---
import { toolkit } from '@/config';
import Icon from './Icon.astro';

const { note, links } = toolkit.footer;
---

<footer class="mt-12 border-t border-line bg-bg2 p-4 text-center text-[11px] text-text3 md:p-6">
  {note && <p class="m-0 mb-2 text-[12px] text-text2">{note}</p>}
  {
    links.length > 0 && (
      <ul class="m-0 mb-3 flex list-none flex-wrap justify-center gap-x-4 gap-y-1 p-0">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              rel="noopener"
              class="inline-flex items-center gap-1.5 text-text2 hover:text-accent"
            >
              {link.icon && <Icon name={link.icon} size={13} />}
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <p class="m-0 inline-flex items-center gap-1.5 font-semibold text-orange">
    <Icon name="triangle-exclamation" size={12} />
    Check generated configs before applying them. These tools can be wrong.
  </p>
</footer>
